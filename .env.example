# Scrape Creators API key — https://app.scrapecreators.com
# Used to read public view counts for submitted TikTok / Instagram URLs.
SCRAPECREATORS_API_KEY=sk_replace_me

# Provider selection: "scrapecreators" (live) | "mock" (offline dev + tests)
VIEW_PROVIDER=scrapecreators

# HTTP
PORT=3000

# Reference store. The production app should use its own database instead.
DATABASE_PATH=./data/campaign.sqlite

# How long Scrape Creators may serve a cached Instagram response.
# Cached reads cost 0 credits. One of: 1d, 3d, 7d, 14d, 30d
IG_CACHE_MAX_AGE=1d

# Minimum seconds between refreshes of the same submission's view count.
# Guards against burning credits on rapid re-polls.
REFRESH_MIN_INTERVAL_SECONDS=21600

# Comma-separated user IDs treated as campaign admins in the reference server.
# The real app should use its existing group-admin role instead.
ADMIN_USER_IDS=admin_1
