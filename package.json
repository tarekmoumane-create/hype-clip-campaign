{
  "name": "hype-clip-campaign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation + spec for Hype's in-chat video submission and approval flow",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
